# Production URL — used for canonical, Open Graph, sitemap.xml, robots.txt and JSON-LD.
# On Vercel the production hostname is used automatically if this is empty.
NEXT_PUBLIC_SITE_URL=

# Analytics are OFF until this is "true" AND real IDs are set.
# Add a consent mechanism that meets your legal requirements before enabling.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
